/* Pastes — warm paper, jade accents and quiet card surfaces. */
* { margin: 0; padding: 0; outline: 0; font-family: "Segoe UI"; color: #293A35; }
#MainFrame {
	background: transparent; border: 0;
}
#BrandTitle { font-size: 18px; font-weight: 600; color: #273E35; }
#HistoryTab {
	background: transparent; border: 0;
	font-size: 12px; font-weight: 600; color: #237B68;
	padding: 7px 13px;
}
#HistoryCount, #KeyboardHint { color: #77827A; font-size: 11px; }
#EmptyState { color: #77827A; font-size: 14px; background: transparent; }
QListWidget { background: transparent; border: 0; }
QListWidget::item, QListWidget::item:hover, QListWidget::item:selected {
	background: transparent; border: 0;
}
#PasteItemFrame {
	background: transparent; border: 0;
	color: #293A35;
}
#Context { padding: 0; border: 0; background: transparent; }
#ContextTextFrame {
	background: transparent; border: 0;
	padding: 10px 14px; color: #293A35; font-size: 14px;
}
#ContextTextFrame > QLabel {
	background: transparent; border: 0;
	color: #869083; font-size: 11px;
}
#PasteItemFrame[contentKind="code"] #ContextTextFrame {
	background: transparent; border: 0;
	font-family: "Consolas"; color: #E3EEE5; font-size: 13px;
}
#PasteItemFrame[contentKind="code"] #ContextTextFrame > QLabel {
	background: transparent; border: 0;
	font-family: "Segoe UI"; color: #9EB5A7;
}
#ContextPixmapFrame {
	background: transparent; border: 0;
	padding: 6px;
}
#ContextPixmapFrame > QLabel {
	background: transparent; border: 0;
	color: #FFFFFF; font-size: 11px;
}
#Barnner { background: transparent; }
#Barnner > QLabel { background: transparent; }
#Barnner > QLabel#CardType {
	background: transparent; border: 0;
	font-size: 11px; font-weight: 600; color: #927849;
	padding: 3px 7px;
}
#Barnner > QLabel#CardTime { font-size: 10px; color: #929A8F; }
#PasteItemFrame[contentKind="link"] #CardType {
	background: transparent; border: 0;
	color: #347565;
}
#PasteItemFrame[contentKind="image"] #CardType {
	background: transparent; border: 0;
	color: #526F82;
}
#PasteItemFrame[contentKind="file"] #CardType {
	background: transparent; border: 0;
	color: #726484;
}
#PasteItemFrame[contentKind="code"] #CardType {
	background: transparent; border: 0;
	color: #B6D9BF;
}
#PasteItemFrame[contentKind="code"] #CardTime {
	background: transparent; border: 0;
	color: #9EB5A7;
}
#QuickPasteNumber {
	background: transparent; border: 0;
	color: #78887B;
	font-size: 11px; font-weight: 600;
}
#SearchBar { padding: 0; margin: 0; border: 0; background: transparent; }
#SearchBar > QLineEdit {
	background: transparent; border: 0;
	font-size: 13px; color: #293A35;
	padding-right: 8px;
	selection-background-color: #D1E9DF; selection-color: #203B34;
}
#PanelMenu {
	background: transparent; border: 0;
	font-size: 24px; color: #66776B;
}
QMenu { background: #FFFDF8; color: #293A35; border: 1px solid #D8DED2; padding: 6px; }
QMenu::item { padding: 7px 22px 7px 12px; border-radius: 5px; }
QMenu::item:selected { background: #E0EDE4; color: #237B68; }
QMenu::separator { height: 1px; background: #E5E8DF; margin: 5px 8px; }
