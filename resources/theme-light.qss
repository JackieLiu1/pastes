/* Pastes — warm paper, jade accents and quiet card surfaces. */
* { margin: 0; padding: 0; outline: 0; font-family: "Segoe UI"; color: #293A35; }
#MainFrame {
	background: transparent; border: 0;
}
#BrandTitle { font-size: 18px; font-weight: 600; color: #273E35; }
#HeaderDivider { background: rgba(41, 58, 53, 45); border: 0; }
#HistoryTab {
	background: transparent; border: 0;
	font-size: 13px; font-weight: 400; color: #43514B;
	padding: 0;
}
#HistoryCount, #KeyboardHint { color: #303735; font-size: 11px; }
#EmptyState { color: #303735; font-size: 14px; background: transparent; }
QListWidget { background: transparent; border: 0; }
QListWidget::item, QListWidget::item:hover, QListWidget::item:selected {
	background: transparent; border: 0;
}
#PasteItemFrame {
	background: transparent; border: 0;
	color: #293A35;
}
#Context { padding: 0; border: 0; background: transparent; }
#ContextColorFrame {
	background: transparent; border: 0;
	font-size: 20px; font-weight: 600;
}
#ContextTextFrame {
	background: transparent; border: 0;
	padding: 10px 14px; color: #293A35; font-size: 14px;
}
#ContextTextFrame > QLabel {
	background: transparent; border: 0;
	color: #59695F; font-size: 11px;
}
#PasteItemFrame[contentKind="code"] #ContextTextFrame {
	background: transparent; border: 0;
	font-family: "Consolas"; color: #E3EEE5; font-size: 13px;
}
#PasteItemFrame[contentKind="code"] #ContextTextFrame > QLabel {
	background: transparent; border: 0;
	font-family: "Segoe UI"; color: #9EB5A7;
}
#ContextPixmapFrame {
	background: transparent; border: 0;
	padding: 6px;
}
#ContextPixmapFrame > QLabel {
	background: transparent; border: 0;
	color: #52645A; font-size: 11px;
}
#Barnner { background: transparent; }
#Barnner > QLabel { background: transparent; }
#Barnner > QLabel#CardType {
	background: transparent; border: 0;
	font-size: 11px; font-weight: 400; color: #52645A;
	padding: 0;
}
#Barnner > QLabel#CardTime { font-size: 10px; color: #59695F; }
#PasteItemFrame[contentKind="code"] #CardType {
	background: transparent; border: 0;
	color: #B6D9BF;
}
#PasteItemFrame[contentKind="code"] #CardTime {
	background: transparent; border: 0;
	color: #9EB5A7;
}
#QuickPasteNumber {
	background: transparent; border: 0;
	color: #52645A;
	font-size: 11px; font-weight: 600;
}
#SearchBar { padding: 0; margin: 0; border: 0; background: transparent; }
#SearchBar > QLineEdit {
	background: transparent; border: 0;
	font-size: 13px; color: #293A35;
	padding-right: 8px;
	selection-background-color: #D1E9DF; selection-color: #203B34;
}
#PanelMenu {
	background: transparent; border: 0;
	font-size: 24px; color: #303735;
}
QMenu { background: #FFFDF8; color: #293A35; border: 1px solid #D8DED2; padding: 6px; }
QMenu::item { padding: 7px 22px 7px 12px; border-radius: 5px; }
QMenu::item:selected { background: #E0EDE4; color: #237B68; }
QMenu::separator { height: 1px; background: #E5E8DF; margin: 5px 8px; }

#PreviewDialog, #PreviewSurface, #PreviewContent { background: transparent; border: 0; }
#PreviewTitle { color: #273E35; font-size: 18px; font-weight: 600; }
#PreviewMeta { color: #58615D; font-size: 11px; }
#PreviewText {
	background: transparent; border: 0; padding: 10px;
	font-size: 14px; color: #293A35;
	selection-background-color: #D1E9DF; selection-color: #203B34;
}
#PreviewAction {
	background: transparent; border: 0; padding: 9px 16px;
	font-size: 12px; font-weight: 600; color: #237B68;
}
#PreviewAction[primary="true"] { color: #FFFFFF; }
#PreviewClose { background: transparent; border: 0; }
#PreviewScroll:vertical { background: transparent; width: 8px; margin: 2px; }
#PreviewScroll::handle:vertical { background: #CED7CC; min-height: 24px; border-radius: 3px; }
#PreviewScroll::add-line:vertical, #PreviewScroll::sub-line:vertical { height: 0; }
#PreviewScroll::add-page:vertical, #PreviewScroll::sub-page:vertical { background: transparent; }
#UndoHint { color: #303735; font-size: 11px; }
#UndoButton { background: transparent; border: 0; color: #124C3D; font-size: 11px; font-weight: 600; padding: 2px 10px; }

#AppDialog, #AppDialogSurface, #AppDialogCard { background: transparent; border: 0; }
#AppDialog, #AppDialog QWidget { font-family: "Microsoft YaHei UI", "Segoe UI", "Noto Sans CJK SC", sans-serif; }
#AppDialogTitle { font-size: 20px; font-weight: 600; color: #273E35; }
#AppDialogMuted { font-size: 12px; color: #58615D; background: transparent; }
#AppDialogValue { font-size: 12px; color: #293A35; background: transparent; }
#AboutBrand { font-size: 28px; font-weight: 600; color: #273E35; }
#AboutVersion { font-size: 11px; color: #237B68; padding: 5px 11px; background: transparent; }
#SettingsScroll, #SettingsBody { background: transparent; border: 0; }
#SettingsSectionTitle { font-size: 12px; font-weight: 600; color: #43514B; }
#SettingsRowTitle { font-size: 13px; font-weight: 600; color: #293A35; }
#SettingsDivider { background: #E5E8DF; border: 0; }
#SettingsChoice { background: transparent; border: 0; color: #43514B; font-size: 12px; }
#SettingsChoice[primary="true"] { color: #FFFFFF; font-weight: 600; }
#SettingsKey { background: transparent; border: 0; padding: 4px 8px; color: #43514B; font-size: 11px; }
#SettingsStatus { font-size: 11px; color: #58615D; }
#SettingsStatus[error="true"] { color: #AD4C35; }
#RecordingStatus { font-size: 11px; color: #AD4C35; }
#MainFrame #RecordingStatus { color: #843C2C; }

#SettingsTabs::pane { border: 0; background: transparent; }
#SettingsTabs QTabBar::tab { background: transparent; border: 0; border-bottom: 2px solid transparent; padding: 10px 24px; margin-right: 12px; color: #58615D; font-size: 13px; font-weight: 600; }
#SettingsTabs QTabBar::tab:selected { color: #007F6C; border-bottom-color: #007F6C; }
#SettingsTabs QTabBar::tab:hover { color: #007F6C; }

QLineEdit[syncField="true"] { border: 1px solid #B8C4BC; border-radius: 7px; padding: 3px 8px; color: #283B35; background: #FFFFFF; }
#SyncAction { background: transparent; border: 0; padding: 8px 12px; font-size: 12px; font-weight: 600; color: #237B68; }
#SyncAction[primary="true"] { color: #FFFFFF; }
#SyncAction:disabled { color: #819087; }
#SyncStatus { color: #34554B; font-size: 12px; }
