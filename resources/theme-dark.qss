/* Pastes — ink green, mint accents and softly separated card surfaces. */
* { margin: 0; padding: 0; outline: 0; font-family: "Segoe UI"; color: #E0E8E2; }
#MainFrame {
	background: transparent; border: 0;
}
#BrandTitle { font-size: 18px; font-weight: 600; color: #E2EDE5; }
#HistoryTab {
	background: transparent; border: 0;
	font-size: 12px; font-weight: 600; color: #89CCB5;
	padding: 7px 13px;
}
#HistoryCount, #KeyboardHint { color: #84988B; font-size: 11px; }
#EmptyState { color: #84988B; font-size: 14px; background: transparent; }
QListWidget { background: transparent; border: 0; }
QListWidget::item, QListWidget::item:hover, QListWidget::item:selected {
	background: transparent; border: 0;
}
#PasteItemFrame {
	background: transparent; border: 0;
	color: #E0E8E2;
}
#Context { padding: 0; border: 0; background: transparent; }
#ContextTextFrame {
	background: transparent; border: 0;
	padding: 10px 14px; color: #E0E8E2; font-size: 14px;
}
#ContextTextFrame > QLabel {
	background: transparent; border: 0;
	color: #8FA392; font-size: 11px;
}
#PasteItemFrame[contentKind="code"] #ContextTextFrame {
	background: transparent; border: 0;
	font-family: "Consolas"; color: #D5E9D9; font-size: 13px;
}
#PasteItemFrame[contentKind="code"] #ContextTextFrame > QLabel {
	background: transparent; border: 0;
	font-family: "Segoe UI"; color: #8FA392;
}
#ContextPixmapFrame {
	background: transparent; border: 0;
	padding: 6px;
}
#ContextPixmapFrame > QLabel {
	background: transparent; border: 0;
	color: #9CAF9F; font-size: 11px;
}
#Barnner { background: transparent; }
#Barnner > QLabel { background: transparent; }
#Barnner > QLabel#CardType {
	background: transparent; border: 0;
	font-size: 11px; font-weight: 400; color: #A7B9AD;
	padding: 0;
}
#Barnner > QLabel#CardTime { font-size: 10px; color: #8FA392; }
#PasteItemFrame[contentKind="code"] #CardType {
	background: transparent; border: 0;
	color: #A6CCA8;
}
#QuickPasteNumber {
	background: transparent; border: 0;
	color: #ADBCAB;
	font-size: 11px; font-weight: 600;
}
#SearchBar { padding: 0; margin: 0; border: 0; background: transparent; }
#SearchBar > QLineEdit {
	background: transparent; border: 0;
	font-size: 13px; color: #E0E8E2;
	padding-right: 8px;
	selection-background-color: #3A6855; selection-color: #FFFFFF;
}
#PanelMenu {
	background: transparent; border: 0;
	font-size: 24px; color: #A0B9A7;
}
QMenu { background: #22352B; color: #E0E8E2; border: 1px solid #3C5342; padding: 6px; }
QMenu::item { padding: 7px 22px 7px 12px; border-radius: 5px; }
QMenu::item:selected { background: #355C46; color: #B5DEC7; }
QMenu::separator { height: 1px; background: #3B5042; margin: 5px 8px; }

#PreviewDialog, #PreviewSurface, #PreviewContent { background: transparent; border: 0; }
#PreviewTitle { color: #E0E8E2; font-size: 18px; font-weight: 600; }
#PreviewMeta { color: #94A99B; font-size: 11px; }
#PreviewText {
	background: transparent; border: 0; padding: 10px;
	font-size: 14px; color: #E0E8E2;
	selection-background-color: #3A6453; selection-color: #F0F6F1;
}
#PreviewAction {
	background: transparent; border: 0; padding: 9px 16px;
	font-size: 12px; font-weight: 600; color: #A3DCC5;
}
#PreviewAction[primary="true"] { color: #173B30; }
#PreviewClose { background: transparent; border: 0; color: #A7B9AD; font-size: 23px; }
#PreviewScroll:vertical { background: transparent; width: 8px; margin: 2px; }
#PreviewScroll::handle:vertical { background: #526B5C; min-height: 24px; border-radius: 3px; }
#PreviewScroll::add-line:vertical, #PreviewScroll::sub-line:vertical { height: 0; }
#PreviewScroll::add-page:vertical, #PreviewScroll::sub-page:vertical { background: transparent; }
#CardPreview, #CardDelete { background: transparent; border: 0; padding: 0; }
#UndoHint { color: #94A99B; font-size: 11px; }
#UndoButton { background: transparent; border: 0; color: #A3DCC5; font-size: 11px; font-weight: 600; padding: 2px 10px; }
