/* Pastes — neutral charcoal surfaces with mint accents for actions and selection. */
* { margin: 0; padding: 0; outline: 0; font-family: "Segoe UI"; color: #E6E6E6; }
#MainFrame {
	background: transparent; border: 0;
}
#BrandTitle { font-size: 18px; font-weight: 600; color: #F1F1F1; }
#HeaderDivider { background: rgba(230, 230, 230, 45); border: 0; }
#HistoryTab {
	background: transparent; border: 0;
	font-size: 13px; font-weight: 400; color: #B5C8C1;
	padding: 0;
}
#HistoryCount, #KeyboardHint { color: #9C9C9C; font-size: 11px; }
#EmptyState { color: #9C9C9C; font-size: 14px; background: transparent; }
QListWidget { background: transparent; border: 0; }
QListWidget::item, QListWidget::item:hover, QListWidget::item:selected {
	background: transparent; border: 0;
}
#PasteItemFrame {
	background: transparent; border: 0;
	color: #E6E6E6;
}
#Context { padding: 0; border: 0; background: transparent; }
#ContextColorFrame {
	background: transparent; border: 0;
	font-size: 20px; font-weight: 600;
}
#ContextTextFrame {
	background: transparent; border: 0;
	padding: 10px 14px; color: #E6E6E6; font-size: 14px;
}
#ContextTextFrame > QLabel {
	background: transparent; border: 0;
	color: #9C9C9C; font-size: 11px;
}
#PasteItemFrame[contentKind="code"] #ContextTextFrame {
	background: transparent; border: 0;
	font-family: "Consolas"; color: #E0E0E0; font-size: 13px;
}
#PasteItemFrame[contentKind="code"] #ContextTextFrame > QLabel {
	background: transparent; border: 0;
	font-family: "Segoe UI"; color: #9C9C9C;
}
#ContextPixmapFrame {
	background: transparent; border: 0;
	padding: 6px;
}
#ContextPixmapFrame > QLabel {
	background: transparent; border: 0;
	color: #A8A8A8; font-size: 11px;
}
#Barnner { background: transparent; }
#Barnner > QLabel { background: transparent; }
#Barnner > QLabel#CardType {
	background: transparent; border: 0;
	font-size: 11px; font-weight: 400; color: #B5B5B5;
	padding: 0;
}
#Barnner > QLabel#CardTime { font-size: 10px; color: #9C9C9C; }
#PasteItemFrame[contentKind="code"] #CardType {
	background: transparent; border: 0;
	color: #B5B5B5;
}
#QuickPasteNumber {
	background: transparent; border: 0;
	color: #B8B8B8;
	font-size: 11px; font-weight: 600;
}
#SearchBar { padding: 0; margin: 0; border: 0; background: transparent; }
#SearchBar > QLineEdit {
	background: transparent; border: 0;
	font-size: 13px; color: #E6E6E6;
	padding-right: 8px;
	selection-background-color: #3A6855; selection-color: #FFFFFF;
}
#PanelMenu {
	background: transparent; border: 0;
	font-size: 24px; color: #B5B5B5;
}
QMenu { background: #242424; color: #E6E6E6; border: 1px solid #434343; padding: 6px; }
QMenu::item { padding: 7px 22px 7px 12px; border-radius: 5px; }
QMenu::item:selected { background: #333333; color: #E6E6E6; }
QMenu::separator { height: 1px; background: #414141; margin: 5px 8px; }

#PreviewDialog, #PreviewSurface, #PreviewContent { background: transparent; border: 0; }
#PreviewTitle { color: #E6E6E6; font-size: 18px; font-weight: 600; }
#PreviewMeta { color: #9C9C9C; font-size: 11px; }
#PreviewText {
	background: transparent; border: 0; padding: 10px;
	font-size: 14px; color: #E6E6E6;
	selection-background-color: #3A6453; selection-color: #FFFFFF;
}
#PreviewAction {
	background: transparent; border: 0; padding: 9px 16px;
	font-size: 12px; font-weight: 600; color: #A3DCC5;
}
#PreviewAction[primary="true"] { color: #173B30; }
#PreviewClose { background: transparent; border: 0; color: #B5B5B5; font-size: 23px; }
#PreviewScroll:vertical { background: transparent; width: 8px; margin: 2px; }
#PreviewScroll::handle:vertical { background: #5A5A5A; min-height: 24px; border-radius: 3px; }
#PreviewScroll::add-line:vertical, #PreviewScroll::sub-line:vertical { height: 0; }
#PreviewScroll::add-page:vertical, #PreviewScroll::sub-page:vertical { background: transparent; }
#UndoHint { color: #9C9C9C; font-size: 11px; }
#UndoButton { background: transparent; border: 0; color: #A3DCC5; font-size: 11px; font-weight: 600; padding: 2px 10px; }

#AppDialog, #AppDialogSurface, #AppDialogCard { background: transparent; border: 0; }
#AppDialog, #AppDialog QWidget { font-family: "Microsoft YaHei UI", "Segoe UI", "Noto Sans CJK SC", sans-serif; }
#AppDialogTitle { font-size: 20px; font-weight: 600; color: #F1F1F1; }
#AppDialogMuted { font-size: 12px; color: #9C9C9C; background: transparent; }
#AppDialogValue { font-size: 12px; color: #E6E6E6; background: transparent; }
#AboutBrand { font-size: 28px; font-weight: 600; color: #F1F1F1; }
#AboutVersion { font-size: 11px; color: #A3DCC5; padding: 5px 11px; background: transparent; }
#SettingsScroll, #SettingsBody { background: transparent; border: 0; }
#SettingsSectionTitle { font-size: 12px; font-weight: 600; color: #B5B5B5; }
#SettingsRowTitle { font-size: 13px; font-weight: 600; color: #E6E6E6; }
#SettingsDivider { background: #3D3D3D; border: 0; }
#SettingsChoice { background: transparent; border: 0; color: #B5B5B5; font-size: 12px; }
#SettingsChoice[primary="true"] { color: #173B30; font-weight: 600; }
#SettingsKey { background: transparent; border: 0; padding: 4px 8px; color: #B8B8B8; font-size: 11px; }
#SettingsStatus { font-size: 11px; color: #9C9C9C; }
#SettingsStatus[error="true"] { color: #E7A28C; }
#RecordingStatus { font-size: 11px; color: #E7A28C; }

#SettingsTabs::pane { border: 0; background: transparent; }
#SettingsTabs QTabBar::tab { background: transparent; border: 0; border-bottom: 2px solid transparent; padding: 10px 24px; margin-right: 12px; color: #B5B5B5; font-size: 13px; font-weight: 600; }
#SettingsTabs QTabBar::tab:selected { color: #76C5AA; border-bottom-color: #76C5AA; }
#SettingsTabs QTabBar::tab:hover { color: #76C5AA; }

QLineEdit[syncField="true"] { border: 1px solid #4C514F; border-radius: 7px; padding: 3px 8px; color: #F2F2F2; background: #202321; }
#SyncAction { background: transparent; border: 0; padding: 8px 12px; font-size: 12px; font-weight: 600; color: #A3DCC5; }
#SyncAction[primary="true"] { color: #173B30; }
#SyncAction:disabled { color: #777777; }
#SyncStatus { color: #B5DACF; font-size: 12px; }
